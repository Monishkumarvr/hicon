[Unit]
Description=HiCon Timeline MediaMTX (dedicated, isolated from hicon-mediamtx)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hicon
Group=hicon
WorkingDirectory=/home/hicon/hicon/ai_vision
ExecStart=/home/hicon/hicon/ai_vision/tools/start_mediamtx_timeline.sh
Restart=always
RestartSec=2

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hicon-timeline-mediamtx

[Install]
WantedBy=multi-user.target
